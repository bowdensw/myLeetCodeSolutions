# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def addTwoNumbers(self, l1: Optional[ListNode], l2: Optional[ListNode]) -> Optional[ListNode]:
        carry = 0
        dummy = ListNode(0)
        cur1 = l1
        cur2 = l2
        curSol = dummy

        while (cur1 is not None and cur2 is not None):
            sum = cur1.val + cur2.val + carry
            if (sum >= 10):
                digit = sum % 10
                curSol.next = ListNode(digit)
                carry = 1
            else:
                digit = sum
                curSol.next = ListNode(digit)
                carry = 0
            curSol = curSol.next; cur1 = cur1.next; cur2 = cur2.next
        while (cur1 is not None):
            sum = cur1.val + carry
            if (sum >= 10):
                digit = sum % 10; 
                curSol.next = ListNode(digit)
                carry = 1
            else:
                curSol.val = sum; carry = 0
            curSol = curSol.next; cur1 = cur1.next

        while (cur2 is not None):
            sum = cur2.val + carry
            if (sum >= 10):
                digit = sum % 10
                curSol.next = ListNode(digit)
                carry = 1
            else:
                digit = sum
                curSol.next = ListNode(digit)
                carry = 0

            curSol = curSol.next; cur2 = cur2.next
        if carry == 1:
            curSol.next = ListNode(carry)
        return dummy.next