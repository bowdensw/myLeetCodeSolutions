# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def nodesBetweenCriticalPoints(self, head: Optional[ListNode]) -> List[int]:
        
        idx = 1
        indexes = []

        prev = head
        cur = head.next
        while(cur.next is not None):
            if (prev.val > cur.val and cur.next.val > cur.val):
                    #tru
                    indexes.append(idx)
            if (prev.val < cur.val and cur.next.val < cur.val):
                    indexes.append(idx)
            idx +=1
            prev = cur
            cur = cur.next
        min = 0
        prev = -1
        n = len(indexes)
        if n < 2:
            return [-1,-1]
        min_dist = float('inf')

        for i in range(1,n):
            if (min_dist >= (indexes[i] - indexes[i-1])):
                min_dist = indexes[i] - indexes[i-1]

        max_dist = indexes[-1] - indexes[0]


        return [min_dist, max_dist]



            
        

            
        
        