class Solution:
    def merge(self, nums1: List[int], m: int, nums2: List[int], n: int) -> None:
        p1 = m - 1; p2 = n - 1
        while p1 >= 0 and p2 >= 0:
            if nums1[p1] > nums2[p2]:
                temp = nums1[p1]
                nums1[p1] = nums2[p2]
                nums2[p2] = temp
                p1 -= 1
            else:
                p2 -= 1
        start1 = m
        start2 = 0
        while start1 < m + n:
            nums1[start1] = nums2[start2]
            start1 += 1
            start2 += 1
